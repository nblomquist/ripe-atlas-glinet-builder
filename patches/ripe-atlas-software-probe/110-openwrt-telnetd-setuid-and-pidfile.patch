diff --git a/bin/arch/linux/linux-functions.sh b/bin/arch/linux/linux-functions.sh
--- a/bin/arch/linux/linux-functions.sh
+++ b/bin/arch/linux/linux-functions.sh
@@ -120,9 +120,19 @@ kill_perds()
 }
 kill_telnetd()
 {
-	if [ -f $STATUS_DIR/telnetd-port$TELNETD_PORT-pid.vol ] ; then
-		kill -9 `tail -1 $STATUS_DIR/telnetd-port$TELNETD_PORT-pid.vol` 2>/dev/null
-	fi
+	for pid_file in \
+		$RUN_DIR/telnetd-port$TELNETD_PORT-pid.vol \
+		$STATUS_DIR/telnetd-port$TELNETD_PORT-pid.vol
+	do
+		[ -f $pid_file ] || continue
+		pid=`tail -1 $pid_file`
+		case "$pid" in
+		''|*[!0-9]*) continue ;;
+		esac
+		[ "$(cat /proc/$pid/comm 2>/dev/null)" = 'telnetd' ] || continue
+		[ "$(readlink /proc/$pid/exe 2>/dev/null)" = "$ATLAS_MEASUREMENT/busybox" ] || continue
+		kill -9 $pid 2>/dev/null
+	done
 }
