diff --git a/openwrt/files/ripe-atlas.init b/openwrt/files/ripe-atlas.init
index 770087f..4a0384a 100755
--- a/openwrt/files/ripe-atlas.init
+++ b/openwrt/files/ripe-atlas.init
@@ -142,6 +142,14 @@ stop_service()
 	local pids
 	local pid
 
+	for pid_file in \
+		${IPKG_INSTROOT}/var/run/ripe-atlas/pids/telnetd-port*-pid.vol \
+		${IPKG_INSTROOT}/var/run/ripe-atlas/status/telnetd-port*-pid.vol
+	do
+		[ -f "${pid_file}" ] || continue
+		pid="$(tail -1 "${pid_file}")"
+		[ -n "${pid}" ] && kill "${pid}" 1>/dev/null 2>&1
+	done
 	for pid in $(find /proc -type d -maxdepth 1 -group ${GROUP} -print); do
 		pids="${pid##*/} ${pids}"
 	done
